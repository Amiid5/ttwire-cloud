{
  "kind": "collectionType",
  "collectionName": "firm_stores",
  "info": {
    "singularName": "firm-store",
    "pluralName": "firm-stores",
    "displayName": "firm-store"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "url": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "string"
    },
    "store_status": {
      "type": "enumeration",
      "enum": ["active", "inactive"]
    },
    "rating_score": {
      "type": "decimal"
    },
    "rating_count": {
      "type": "integer"
    },
    "last_verified_at": {
      "type": "datetime"
    },
    "h1_title": {
      "type": "string"
    },
    "banner_section": {
      "type": "component",
      "component": "firms-shared.banner-section",
      "repeatable": false
    },
    "about_card": {
      "type": "component",
      "component": "firms-cards.about-card",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "firms-shared.seo-fields",
      "repeatable": false
    },
    "pros_cons_card": {
      "type": "component",
      "component": "firms-cards.pros-cons-card",
      "repeatable": false
    },
    "faq_card": {
      "type": "component",
      "component": "firms-cards.faq-card",
      "repeatable": false
    },
    "funding_programs_card": {
      "type": "component",
      "component": "firms-cards.funding-programs-card",
      "repeatable": false
    },
    "trading_flexibility_card": {
      "type": "component",
      "component": "firms-cards.trading-flexibility-card",
      "repeatable": false
    },
    "risk_management_card": {
      "type": "component",
      "component": "firms-cards.risk-management-card",
      "repeatable": false
    },
    "account_models_card": {
      "type": "component",
      "component": "firms-cards.account-models-card",
      "repeatable": false
    },
    "trading_technology_card": {
      "type": "component",
      "component": "firms-cards.trading-technology-card",
      "repeatable": false
    },
    "economics_scaling_card": {
      "type": "component",
      "component": "firms-cards.economics-scaling-card",
      "repeatable": false
    },
    "payments_payouts_card": {
      "type": "component",
      "component": "firms-cards.payments-payouts-card",
      "repeatable": false
    },
    "coupons": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::coupon.coupon",
      "mappedBy": "firm_store"
    }
  }
}
